# No real values belong in this file or in the repository. Real values are
# set per-context in Netlify's environment-variable UI only.

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SITE_URL=https://reserveinvestmentgroup.com
LEAD_FORM_DESTINATION_WEBHOOK_URL=

# Added 2026-08-06 — folk CRM forwarding for lead-magnet downloads
# (EMAIL-NURTURE-SEQUENCES.md trigger mechanism). Generate in folk:
# workspace settings → API. Set per-context in Netlify's UI only, never
# here or in the repo.
FOLK_API_KEY=

# Added 2026-08-06 — signs unsubscribe links so a stranger can't
# unsubscribe someone else's address by guessing a URL. Generate any long
# random string once (e.g. `openssl rand -hex 32`) and set it in Netlify;
# changing it later invalidates every unsubscribe link already sent.
UNSUBSCRIBE_SECRET=

# Added 2026-08-06 — lets nurture emails send with a real
# "From: info@reserveinvestmentgroup.com" instead of the connected
# Outlook connector's fixed sender. Requires tenant-admin setup this repo
# cannot do for you — see MISSING-INFORMATION-REGISTER.md #17b for the
# full checklist before setting these.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The real mailbox the app is authorized to send as (Application Access
# Policy scopes to this exact mailbox) — currently ron.shaw@reserveinvestmentgroup.com.
MS_GRAPH_SEND_AS_MAILBOX=
# The alias/proxy address to show as the From address — must already
# exist as a proxy address on MS_GRAPH_SEND_AS_MAILBOX in Exchange.
MS_GRAPH_FROM_ALIAS=info@reserveinvestmentgroup.com

# Added 2026-08-06 — shared secret protecting
# netlify/functions/send-nurture-email.ts, the internal endpoint the
# scheduled sender job calls instead of talking to Microsoft Graph
# directly (keeps the Graph credentials above out of the scheduled
# task's own plaintext prompt file). Generate with `openssl rand -hex 32`.
INTERNAL_SEND_SECRET=
